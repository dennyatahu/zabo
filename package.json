{
  "name": "zabo",
  "version": "2.0.0",
  "description": "Fast & modern WhatsApp bot built with zapo-js. Lightweight, plugin-based, and ESM-only.",
  "keywords": [
    "whatsapp",
    "whatsapp-bot",
    "bot",
    "zapo-js",
    "plugin",
    "nodejs",
    "esm"
  ],
  "homepage": "https://github.com/dennyatahu/zabo#readme",
  "bugs": {
    "url": "https://github.com/dennyatahu/zabo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dennyatahu/zabo.git"
  },
  "license": "MIT",
  "author": {
    "name": "dennyatahu",
    "url": "https://github.com/dennyatahu"
  },
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.5.0"
  },
