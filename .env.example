# Login method (default: pair)
#   pair -> link with a pairing code, BOT_PN is required
#   qr   -> link by scanning a QR code in the terminal, BOT_PN is not needed
AUTH_METHOD=pair

# Bot phone number: digits only, with country code, no "+" or spaces (e.g. 628123456789)
# Required when AUTH_METHOD=pair. Ignored when AUTH_METHOD=qr.
BOT_PN=

# Bot name used by the lock and unlock commands (default: zabo)
BOT_NAME=zabo

# Default menu link preview title and description.
# Can be changed in chat with: menu set title <value> / menu set desc <value>
TITLE_MENU=zabo
DESC_MENU=by dennyatahu

# Owner number(s) allowed to use owner commands, comma-separated (e.g. 628111111111,628222222222)
OWNER=

# Log level: trace, debug, info, warn, error, fatal, or silent (default: info)
LOG_LEVEL=info
